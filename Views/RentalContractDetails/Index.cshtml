@model IEnumerable<CarRentalManagementSystem.Models.RentalContractDetail>
@{
    ViewData["Title"] = "Contract Details";
}

<div class="page-header">
    <div>
        <h1>Contract Details</h1>
        <p class="page-subtitle">Cars linked to each rental contract</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Detail</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Contract</th>
                    <th>Customer</th>
                    <th>Car</th>
                    <th>Daily Rate</th>
                    <th>Days</th>
                    <th>Subtotal</th>
                    <th>Discount</th>
                    <th>Deposit</th>
                    <th>Total</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.RentalContract?.ContractNumber</strong></td>
                    <td>@item.RentalContract?.Customer?.FullName</td>
                    <td>@item.Car?.Make @item.Car?.Model (@item.Car?.LicensePlate)</td>
                    <td class="money">@item.DailyRate.ToString("C")</td>
                    <td>@item.Days</td>
                    <td class="money">@item.SubTotal.ToString("C")</td>
                    <td class="money">@((item.RentalContract?.DiscountAmount ?? 0).ToString("C"))</td>
                    <td class="money">@((item.RentalContract?.DepositAmount ?? 0).ToString("C"))</td>
                    <td class="money">@{
                        var rowTotal = Math.Max(0,
                            item.SubTotal
                            - (item.RentalContract?.DiscountAmount ?? 0)
                            - (item.RentalContract?.DepositAmount ?? 0));
                    }@rowTotal.ToString("C")</td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.DetailId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.DetailId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.DetailId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
