@model CarRentalManagementSystem.Models.RentalContractDetail

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>RentalContractDetail</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DailyRate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DailyRate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Days)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Days)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SubTotal)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SubTotal)
        </dd>
        <dt class = "col-sm-2">
            Discount
        </dt>
        <dd class = "col-sm-10">
            @((Model.RentalContract?.DiscountAmount ?? 0).ToString("C"))
        </dd>
        <dt class = "col-sm-2">
            Deposit Amount
        </dt>
        <dd class = "col-sm-10">
            @((Model.RentalContract?.DepositAmount ?? 0).ToString("C"))
        </dd>
        <dt class = "col-sm-2">
            Total
        </dt>
        <dd class = "col-sm-10">
            @{
                var deleteTotal = Math.Max(0,
                    Model.SubTotal
                    - (Model.RentalContract?.DiscountAmount ?? 0)
                    - (Model.RentalContract?.DepositAmount ?? 0));
            }
            @deleteTotal.ToString("C")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RentalContract)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RentalContract.ContractNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Car)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Car.LicensePlate)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="DetailId" />
        <div class="page-actions mt-2"><button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a></div>
    </form>
</div>
