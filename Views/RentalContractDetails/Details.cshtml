@model CarRentalManagementSystem.Models.RentalContractDetail
@{
    ViewData["Title"] = "Contract Detail";
}

<div class="page-header">
    <div>
        <h1>Contract Detail</h1>
        <p class="page-subtitle">Car linked to this rental contract</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="form-panel">
    <dl class="row mb-0">
        <dt class="col-sm-2">Contract</dt>
        <dd class="col-sm-10">@Model.RentalContract?.ContractNumber</dd>
        <dt class="col-sm-2">Customer</dt>
        <dd class="col-sm-10">@Model.RentalContract?.Customer?.FullName</dd>
        <dt class="col-sm-2">Car</dt>
        <dd class="col-sm-10">@Model.Car?.Make @Model.Car?.Model (@Model.Car?.LicensePlate)</dd>
        <dt class="col-sm-2">Daily Rate</dt>
        <dd class="col-sm-10 money">@Model.DailyRate.ToString("C")</dd>
        <dt class="col-sm-2">Days</dt>
        <dd class="col-sm-10">@Model.Days</dd>
        <dt class="col-sm-2">Sub Total</dt>
        <dd class="col-sm-10 money">@Model.SubTotal.ToString("C")</dd>
        <dt class="col-sm-2">Discount</dt>
        <dd class="col-sm-10 money">@((Model.RentalContract?.DiscountAmount ?? 0).ToString("C"))</dd>
        <dt class="col-sm-2">Deposit Amount</dt>
        <dd class="col-sm-10 money">@((Model.RentalContract?.DepositAmount ?? 0).ToString("C"))</dd>
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10 money">@{
            var detailTotal = Math.Max(0,
                Model.SubTotal
                - (Model.RentalContract?.DiscountAmount ?? 0)
                - (Model.RentalContract?.DepositAmount ?? 0));
        }@detailTotal.ToString("C")</dd>
        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">@(Model.Notes ?? "—")</dd>
    </dl>
</div>

<div class="page-actions mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.DetailId"><i class="bi bi-pencil-square"></i> Edit</a>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>
