@model CarRentalManagementSystem.Models.CarMaintenance

@{
    ViewData["Title"] = "Edit";
}

<div class="page-header"><div><h1>Edit</h1><p class="page-subtitle">CarMaintenance</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a></div></div>
