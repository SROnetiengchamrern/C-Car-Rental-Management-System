@model IEnumerable<CarRentalManagementSystem.Models.CarMaintenance>
@{
    ViewData["Title"] = "Car Maintenance";
}

<div class="page-header">
    <div>
        <h1>Car Maintenance</h1>
        <p class="page-subtitle">Service schedule and repair history</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Maintenance</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Car</th>
                    <th>Type</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Cost</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var statusClass = "status-" + (item.Status ?? "").Replace(" ", "").ToLowerInvariant();
                <tr>
                    <td><strong>@item.Car?.Make @item.Car?.Model</strong> <span class="text-muted">(@item.Car?.LicensePlate)</span></td>
                    <td>@item.MaintenanceType</td>
                    <td>@item.StartDate.ToString("dd MMM yyyy")</td>
                    <td>@(item.EndDate?.ToString("dd MMM yyyy") ?? "—")</td>
                    <td class="money">@item.Cost.ToString("C")</td>
                    <td><span class="status-badge @statusClass">@item.Status</span></td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.MaintenanceId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.MaintenanceId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.MaintenanceId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
