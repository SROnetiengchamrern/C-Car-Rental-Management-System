@model IEnumerable<CarRentalManagementSystem.Models.CarReturn>
@{
    ViewData["Title"] = "Car Returns";
}

<div class="page-header">
    <div>
        <h1>Car Returns</h1>
        <p class="page-subtitle">Vehicles returned from rental</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Process Return</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Return Date</th>
                    <th>Contract</th>
                    <th>Car</th>
                    <th>Odometer</th>
                    <th>Fees</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var statusClass = "status-" + (item.Status ?? "").Replace(" ", "").ToLowerInvariant();
                <tr>
                    <td>@item.ReturnDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td><strong>@item.RentalContract?.ContractNumber</strong></td>
                    <td>@item.Car?.Make @item.Car?.Model</td>
                    <td>@item.OdometerReading.ToString("N0")</td>
                    <td class="money">@((item.LateFee + item.DamageFee).ToString("C"))</td>
                    <td><span class="status-badge @statusClass">@item.Status</span></td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.ReturnId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.ReturnId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.ReturnId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
