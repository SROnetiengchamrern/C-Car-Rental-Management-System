@model IEnumerable<CarRentalManagementSystem.Models.Branch>
@{
    ViewData["Title"] = "Branches";
}

<div class="page-header">
    <div>
        <h1>Branches</h1>
        <p class="page-subtitle">Locations and contact details</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Branch</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Branch</th>
                    <th>City</th>
                    <th>Phone</th>
                    <th>Manager</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.BranchName</strong>
                        <div class="text-muted small">@item.Address</div>
                    </td>
                    <td>@item.City</td>
                    <td>@item.Phone</td>
                    <td>@item.ManagerName</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="status-badge status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge status-cancelled">Inactive</span>
                        }
                    </td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.BranchId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.BranchId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.BranchId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
