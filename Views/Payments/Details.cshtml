<div class="page-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.PaymentId"><i class="bi bi-pencil-square"></i> Edit</a><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a></div>
