@model IEnumerable<CarRentalManagementSystem.Models.Payment>
@{
    ViewData["Title"] = "Payments";
}

<div class="page-header">
    <div>
        <h1>Payments</h1>
        <p class="page-subtitle">Incoming payments by contract</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Payment</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Contract</th>
                    <th>Amount</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th>Received By</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var statusClass = "status-" + (item.Status ?? "").Replace(" ", "").ToLowerInvariant();
                <tr>
                    <td>@item.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td><strong>@item.RentalContract?.ContractNumber</strong>
                        <div class="text-muted small">@item.RentalContract?.Customer?.FullName</div>
                    </td>
                    <td class="money">@item.Amount.ToString("C")</td>
                    <td>@item.PaymentMethod</td>
                    <td><span class="status-badge @statusClass">@item.Status</span></td>
                    <td>@item.ReceivedByEmployee?.FullName</td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.PaymentId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.PaymentId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.PaymentId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
