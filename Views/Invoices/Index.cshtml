@model IEnumerable<CarRentalManagementSystem.ViewModels.InvoiceListItemViewModel>
@{
    ViewData["Title"] = "Invoices";
}

<div class="page-header">
    <div>
        <h1>Invoices</h1>
        <p class="page-subtitle">Rental invoices generated from contracts</p>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Invoice #</th>
                    <th>Customer</th>
                    <th>Car</th>
                    <th>Branch</th>
                    <th>Period</th>
                    <th>Sub Total</th>
                    <th>Discount</th>
                    <th>Total Due</th>
                    <th>Deposit</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var statusClass = "status-" + (item.Status ?? "").Replace(" ", "").ToLowerInvariant();
                <tr>
                    <td><strong>@item.InvoiceNumber</strong></td>
                    <td>@item.CustomerName</td>
                    <td>@item.CarsSummary</td>
                    <td>@item.BranchName</td>
                    <td>@item.StartDate.ToString("dd MMM yyyy") – @item.EndDate.ToString("dd MMM yyyy")</td>
                    <td class="money">@item.SubTotal.ToString("C")</td>
                    <td class="money">@item.DiscountAmount.ToString("C")</td>
                    <td class="money">@item.TotalDue.ToString("C")</td>
                    <td class="money">@item.DepositAmount.ToString("C")</td>
                    <td class="money">@item.TotalAmount.ToString("C")</td>
                    <td><span class="status-badge @statusClass">@item.Status</span></td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.ContractId">
                                <i class="bi bi-receipt"></i> View
                            </a>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="RentalContracts" asp-action="Details" asp-route-id="@item.ContractId">
                                <i class="bi bi-file-earmark-text"></i> Contract
                            </a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
