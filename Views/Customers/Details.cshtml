@model CarRentalManagementSystem.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
}

<div class="page-header">
    <div>
        <h1>@Model.FullName</h1>
        <p class="page-subtitle">Customer profile and rental history</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

<div class="form-panel mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Phone)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Phone)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Address)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Address), @Html.DisplayFor(model => model.City)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LicenseNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LicenseNumber)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.LicenseExpiry)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LicenseExpiry)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DateOfBirth)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DateOfBirth)</dd>
    </dl>
</div>

<div class="page-header">
    <div>
        <h2 class="h4 mb-0">Rental history</h2>
        <p class="page-subtitle">Contracts and cars this customer rented</p>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 w-100">
            <thead>
                <tr>
                    <th>Contract #</th>
                    <th>Car</th>
                    <th>Branch</th>
                    <th>Period</th>
                    <th>Discount</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.RentalContracts?.Any() == true)
            {
                foreach (var contract in Model.RentalContracts.OrderByDescending(c => c.StartDate))
                {
                    var statusClass = "status-" + (contract.Status ?? "").Replace(" ", "").ToLowerInvariant();
                    var cars = contract.RentalContractDetails?
                        .Where(d => d.Car != null)
                        .Select(d => $"{d.Car!.Make} {d.Car.Model} ({d.Car.LicensePlate})")
                        .ToList() ?? new List<string>();
                    <tr>
                        <td>
                            <a asp-controller="RentalContracts" asp-action="Details" asp-route-id="@contract.ContractId">
                                <strong>@contract.ContractNumber</strong>
                            </a>
                        </td>
                        <td>
                            @if (cars.Any())
                            {
                                @string.Join(", ", cars)
                            }
                            else
                            {
                                <span class="text-muted">No car linked</span>
                            }
                        </td>
                        <td>@contract.Branch?.BranchName</td>
                        <td>@contract.StartDate.ToString("dd MMM yyyy") – @contract.EndDate.ToString("dd MMM yyyy")</td>
                        <td class="money">@contract.DiscountAmount.ToString("C")</td>
                        <td class="money">@contract.TotalAmount.ToString("C")</td>
                        <td><span class="status-badge @statusClass">@contract.Status</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-muted text-center py-4">No rentals for this customer yet.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="page-actions mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.CustomerId"><i class="bi bi-pencil-square"></i> Edit</a>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>
