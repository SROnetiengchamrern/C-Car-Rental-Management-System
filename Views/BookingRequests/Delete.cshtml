@model CarRentalManagementSystem.Models.BookingRequest
@{
    ViewData["Title"] = "Delete Booking Request";
}

<div class="page-header">
    <div>
        <h1>Delete booking request</h1>
        <p class="page-subtitle">@Model.Reference</p>
    </div>
</div>

<div class="alert alert-warning">
    Are you sure you want to delete this booking request from <strong>@Model.FullName</strong>?
</div>

<dl class="row">
    <dt class="col-sm-3">Car</dt>
    <dd class="col-sm-9">@(Model.Car != null ? $"{Model.Car.Make} {Model.Car.Model}" : $"#{Model.CarId}")</dd>
    <dt class="col-sm-3">Dates</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy") – @Model.EndDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="BookingRequestId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</form>
