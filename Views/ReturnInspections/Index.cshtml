@model IEnumerable<CarRentalManagementSystem.Models.ReturnInspection>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p class="page-actions"><a class="btn btn-primary" asp-action="Create">Create New</a></p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.InspectionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExteriorCondition)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InteriorCondition)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HasDamage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DamageDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstimatedRepairCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Notes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CarReturn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InspectedByEmployee)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.InspectionDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExteriorCondition)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InteriorCondition)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HasDamage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DamageDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstimatedRepairCost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CarReturn.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InspectedByEmployee.Email)
            </td>
            <td>
                <div class="table-actions"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.InspectionId">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.InspectionId">Details</a><a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.InspectionId">Delete</a></div>
            </td>
        </tr>
}
    </tbody>
</table>
