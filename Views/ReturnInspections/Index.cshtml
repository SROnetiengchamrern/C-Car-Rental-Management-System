@model IEnumerable<CarRentalManagementSystem.Models.ReturnInspection>
@{
    ViewData["Title"] = "Return Inspections";
}

<div class="page-header">
    <div>
        <h1>Return Inspections</h1>
        <p class="page-subtitle">Condition checks after return</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Inspection</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Return #</th>
                    <th>Inspector</th>
                    <th>Exterior</th>
                    <th>Interior</th>
                    <th>Damage</th>
                    <th>Est. Cost</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InspectionDate.ToString("dd MMM yyyy")</td>
                    <td>#@item.ReturnId</td>
                    <td>@item.InspectedByEmployee?.FullName</td>
                    <td>@item.ExteriorCondition</td>
                    <td>@item.InteriorCondition</td>
                    <td>
                        @if (item.HasDamage)
                        {
                            <span class="status-badge status-cancelled">Yes</span>
                        }
                        else
                        {
                            <span class="status-badge status-available">No</span>
                        }
                    </td>
                    <td class="money">@item.EstimatedRepairCost.ToString("C")</td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.InspectionId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.InspectionId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.InspectionId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
