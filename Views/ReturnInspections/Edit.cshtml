@model CarRentalManagementSystem.Models.ReturnInspection

@{
    ViewData["Title"] = "Edit";
}

<div class="page-header"><div><h1>Edit</h1><p class="page-subtitle">ReturnInspection</p></div><div class="page-actions"><a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to List</a></div></div>
<div class="row">
    <div class="col-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="InspectionId" />
            <div class="form-group">
                <label asp-for="ReturnId" class="control-label"></label>
                <select asp-for="ReturnId" class="form-control" asp-items="ViewBag.ReturnId"></select>
                <span asp-validation-for="ReturnId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InspectedByEmployeeId" class="control-label"></label>
                <select asp-for="InspectedByEmployeeId" class="form-control" asp-items="ViewBag.InspectedByEmployeeId"></select>
                <span asp-validation-for="InspectedByEmployeeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InspectionDate" class="control-label"></label>
                <input asp-for="InspectionDate" class="form-control" />
                <span asp-validation-for="InspectionDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExteriorCondition" class="control-label"></label>
                <input asp-for="ExteriorCondition" class="form-control" />
                <span asp-validation-for="ExteriorCondition" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InteriorCondition" class="control-label"></label>
                <input asp-for="InteriorCondition" class="form-control" />
                <span asp-validation-for="InteriorCondition" class="text-danger"></span>
            </div>
            <div class="form-group form-check form-switch">
                <input class="form-check-input" asp-for="HasDamage" />
                <label class="form-check-label" asp-for="HasDamage">
                    Has Damage
                    <span class="check-hint">Mark if damage was found during inspection</span>
                </label>
            </div>
            <div class="form-group form-group-full"><label asp-for="DamageDescription" class="control-label"></label>
                <input asp-for="DamageDescription" class="form-control" />
                <span asp-validation-for="DamageDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EstimatedRepairCost" class="control-label"></label>
                <input asp-for="EstimatedRepairCost" class="form-control" />
                <span asp-validation-for="EstimatedRepairCost" class="text-danger"></span>
            </div>
            <div class="form-group form-group-full"><label asp-for="Notes" class="control-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
