@model IEnumerable<CarRentalManagementSystem.Models.CarStatusHistory>
@{
    ViewData["Title"] = "Car Status History";
}

<div class="page-header">
    <div>
        <h1>Car Status History</h1>
        <p class="page-subtitle">Track status changes across the fleet</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Entry</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>When</th>
                    <th>Car</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Reason</th>
                    <th>Changed By</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ChangedAt.ToString("dd MMM yyyy HH:mm")</td>
                    <td><strong>@item.Car?.Make @item.Car?.Model</strong></td>
                    <td><span class="status-badge status-scheduled">@item.PreviousStatus</span></td>
                    <td><span class="status-badge status-active">@item.NewStatus</span></td>
                    <td>@item.Reason</td>
                    <td>@item.ChangedByEmployee?.FullName</td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.HistoryId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.HistoryId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.HistoryId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
