@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string IsActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Car Rental Management</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarRentalManagementSystem.styles.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-brand">
                <a asp-controller="Home" asp-action="Index"><i class="bi bi-car-front-fill"></i> DriveKhmer</a>
                <button type="button" class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Close menu">&times;</button>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title">Overview</div>
                    <a class="nav-link @IsActive("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Fleet</div>
                    <a class="nav-link @IsActive("Cars")" asp-controller="Cars" asp-action="Index"><i class="bi bi-car-front"></i> Cars</a>
                    <a class="nav-link @IsActive("CarCategories")" asp-controller="CarCategories" asp-action="Index"><i class="bi bi-tags"></i> Car Categories</a>
                    <a class="nav-link @IsActive("CarMaintenances")" asp-controller="CarMaintenances" asp-action="Index"><i class="bi bi-tools"></i> Car Maintenance</a>
                    <a class="nav-link @IsActive("CarStatusHistories")" asp-controller="CarStatusHistories" asp-action="Index"><i class="bi bi-clock-history"></i> Car Status History</a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">People</div>
                    <a class="nav-link @IsActive("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a>
                    <a class="nav-link @IsActive("Employees")" asp-controller="Employees" asp-action="Index"><i class="bi bi-person-badge"></i> Employees</a>
                    <a class="nav-link @IsActive("Branches")" asp-controller="Branches" asp-action="Index"><i class="bi bi-building"></i> Branches</a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Rentals</div>
                    <a class="nav-link @IsActive("BookingRequests")" asp-controller="BookingRequests" asp-action="Index">
                        <i class="bi bi-inbox"></i> Booking Requests
                        <span class="nav-alert-badge d-none" id="bookingRequestBadge">0</span>
                    </a>
                    <a class="nav-link @IsActive("RentalContracts")" asp-controller="RentalContracts" asp-action="Index"><i class="bi bi-file-earmark-text"></i> Rental Contracts</a>
                    <a class="nav-link @IsActive("RentalContractDetails")" asp-controller="RentalContractDetails" asp-action="Index"><i class="bi bi-list-check"></i> Contract Details</a>
                    <a class="nav-link @IsActive("Invoices")" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i> Invoices</a>
                    <a class="nav-link @IsActive("Payments")" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card"></i> Payments</a>
                </div>

                <div class="nav-section">
                    <div class="nav-section-title">Returns</div>
                    <a class="nav-link @IsActive("CarReturns")" asp-controller="CarReturns" asp-action="Index"><i class="bi bi-arrow-return-left"></i> Car Returns</a>
                    <a class="nav-link @IsActive("ReturnInspections")" asp-controller="ReturnInspections" asp-action="Index"><i class="bi bi-clipboard-check"></i> Return Inspections</a>
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="nav-section">
                        <div class="nav-section-title">System</div>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link @(currentController == "Account" ? "active" : "")" asp-controller="Account" asp-action="Users"><i class="bi bi-shield-lock"></i> Users &amp; Roles</a>
                            <a class="nav-link" asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus"></i> Create User</a>
                        }
                        <a class="nav-link @IsActive("Settings")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i> Settings</a>
                    </div>
                }
            </nav>
        </aside>

        <div class="sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle" aria-label="Open menu">
                    <i class="bi bi-list"></i> Menu
                </button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-user ms-auto">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            @(User.Identity?.Name ?? "User")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">Signed in</h6></li>
                            <li><span class="dropdown-item-text small text-muted">@User.Identity?.Name</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="admin-content" role="main">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                &copy; 2026 Car Rental Management System
            </footer>
        </div>
    </div>

    <div id="bookingAlertHost" class="booking-alert-host" aria-live="polite" aria-atomic="true"></div>

    <button type="button" id="calcFab" class="calc-fab" title="Calculator" aria-label="Open calculator">
        <i class="bi bi-calculator"></i>
    </button>

    <div id="calcPopup" class="calc-popup" hidden>
        <div class="calc-popup-header">
            <span><i class="bi bi-calculator"></i> Calculator</span>
            <button type="button" id="calcClose" class="calc-popup-close" aria-label="Close calculator">&times;</button>
        </div>
        <div class="calc-display-wrap">
            <div id="calcExpression" class="calc-expression"></div>
            <div id="calcDisplay" class="calc-display">0</div>
        </div>
        <div class="calc-keys" id="calcKeys">
            <button type="button" data-action="clear" class="calc-key calc-key-muted">C</button>
            <button type="button" data-action="back" class="calc-key calc-key-muted">⌫</button>
            <button type="button" data-op="%" class="calc-key calc-key-op">%</button>
            <button type="button" data-op="/" class="calc-key calc-key-op">÷</button>

            <button type="button" data-num="7" class="calc-key">7</button>
            <button type="button" data-num="8" class="calc-key">8</button>
            <button type="button" data-num="9" class="calc-key">9</button>
            <button type="button" data-op="*" class="calc-key calc-key-op">×</button>

            <button type="button" data-num="4" class="calc-key">4</button>
            <button type="button" data-num="5" class="calc-key">5</button>
            <button type="button" data-num="6" class="calc-key">6</button>
            <button type="button" data-op="-" class="calc-key calc-key-op">−</button>

            <button type="button" data-num="1" class="calc-key">1</button>
            <button type="button" data-num="2" class="calc-key">2</button>
            <button type="button" data-num="3" class="calc-key">3</button>
            <button type="button" data-op="+" class="calc-key calc-key-op">+</button>

            <button type="button" data-num="0" class="calc-key calc-key-zero">0</button>
            <button type="button" data-num="." class="calc-key">.</button>
            <button type="button" data-action="equals" class="calc-key calc-key-eq">=</button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
