@model IEnumerable<CarRentalManagementSystem.Models.CarCategory>
@{
    ViewData["Title"] = "Car Categories";
}

<div class="page-header">
    <div>
        <h1>Car Categories</h1>
        <p class="page-subtitle">Rate groups for the fleet</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Add Category</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Base Daily Rate</th>
                    <th>Active</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.CategoryName</strong></td>
                    <td>@item.Description</td>
                    <td class="money">@item.BaseDailyRate.ToString("C")</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="status-badge status-active">Active</span>
                        }
                        else
                        {
                            <span class="status-badge status-cancelled">Inactive</span>
                        }
                    </td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.CategoryId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.CategoryId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.CategoryId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
