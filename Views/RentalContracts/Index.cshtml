@model IEnumerable<CarRentalManagementSystem.Models.RentalContract>
@{
    ViewData["Title"] = "Rental Contracts";
}

<div class="page-header">
    <div>
        <h1>Rental Contracts</h1>
        <p class="page-subtitle">Active and completed rental agreements</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New Contract</a>
    </div>
</div>

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 datatable w-100">
            <thead>
                <tr>
                    <th>Contract #</th>
                    <th>Customer</th>
                    <th>Car</th>
                    <th>Branch</th>
                    <th>Period</th>
                    <th>Discount</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var statusClass = "status-" + (item.Status ?? "").Replace(" ", "").ToLowerInvariant();
                var cars = item.RentalContractDetails?
                    .Where(d => d.Car != null)
                    .Select(d => $"{d.Car!.Make} {d.Car.Model} ({d.Car.LicensePlate})")
                    .ToList() ?? new List<string>();
                <tr>
                    <td><strong>@item.ContractNumber</strong></td>
                    <td>@item.Customer?.FullName</td>
                    <td>
                        @if (cars.Any())
                        {
                            @string.Join(", ", cars)
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>@item.Branch?.BranchName</td>
                    <td>@item.StartDate.ToString("dd MMM yyyy") – @item.EndDate.ToString("dd MMM yyyy")</td>
                    <td class="money">@item.DiscountAmount.ToString("C")</td>
                    <td class="money">@item.TotalAmount.ToString("C")</td>
                    <td><span class="status-badge @statusClass">@item.Status</span></td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.ContractId"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.ContractId"><i class="bi bi-eye"></i> Details</a>
                            <a class="btn btn-sm btn-outline-success" asp-controller="Invoices" asp-action="Details" asp-route-id="@item.ContractId"><i class="bi bi-receipt"></i> Invoice</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.ContractId"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
